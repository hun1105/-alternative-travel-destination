# 공공데이터포털에서 발급받은 일반 인증키(Decoding 또는 Encoding 키 모두 입력 가능)
KTO_SERVICE_KEY=여기에_서비스키_입력

# 공사 운영계정 심사에서 식별할 서비스 고유명
KTO_MOBILE_APP=PlanB

# WEB, AND, IOS, WIN, ETC 중 선택
KTO_MOBILE_OS=ETC

# 선택 설정
KTO_BASE_URL=https://apis.data.go.kr/B551011/KorService2
KTO_TIMEOUT_SECONDS=10
KTO_MAX_RETRIES=2

# 기상청 단기예보 조회서비스 활용신청 후 받은 일반 인증키
KMA_SERVICE_KEY=여기에_기상청_서비스키_입력

# 선택 설정
KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
KMA_TIMEOUT_SECONDS=10
KMA_MAX_RETRIES=2

# SK open API의 TMAP 보행자 경로 안내 상품에서 발급한 앱 키
TMAP_APP_KEY=여기에_TMAP_앱키_입력

# 선택 설정
TMAP_PEDESTRIAN_URL=https://apis.openapi.sk.com/tmap/routes/pedestrian
TMAP_CAR_URL=https://apis.openapi.sk.com/tmap/routes
TMAP_POI_URL=https://apis.openapi.sk.com/tmap/pois
TMAP_TIMEOUT_SECONDS=10
TMAP_MAX_RETRIES=2

# 기존 SK 장소 혼잡도 단독 확인용. 추천 엔진에서는 사용하지 않음
SK_CROWD_APP_KEY=여기에_SK_장소혼잡도_앱키_입력

# 선택 설정
SK_CROWD_BASE_URL=https://apis.openapi.sk.com/puzzle/place
SK_CROWD_TIMEOUT_SECONDS=10
SK_CROWD_MAX_RETRIES=2

# 서울 열린데이터광장 일반 인증키
SEOUL_OPEN_API_KEY=여기에_서울시_인증키_입력

# 선택 설정
SEOUL_CROWD_BASE_URL=http://openapi.seoul.go.kr:8088
SEOUL_CROWD_TIMEOUT_SECONDS=10
SEOUL_CROWD_MAX_RETRIES=2

# ODsay(https://lab.odsay.com) 회원가입 후 애플리케이션 등록하면 발급되는 키
ODSAY_API_KEY=여기에_ODsay_API_키_입력

# 선택 설정
ODSAY_PATH_URL=https://api.odsay.com/v1/api/searchPubTransPathT
ODSAY_TIMEOUT_SECONDS=10
ODSAY_MAX_RETRIES=2
